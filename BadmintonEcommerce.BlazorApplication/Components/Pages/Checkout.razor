@page "/checkout"
@using BadmintonEcommerce.BlazorApplication.Models
@using BadmintonEcommerce.BlazorApplication.Services
@rendermode InteractiveServer

@inject CartStateService Cart
@inject OrderService OrderService
@inject NavigationManager Nav

<div class="space-y-6">
    <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-energy-blue">Thanh toán</h1>
        <p class="text-slate-600 mt-1">Nhập thông tin nhận hàng và đặt đơn ngay lập tức.</p>
    </div>

    @if (Cart.Items.Count == 0)
    {
        <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-6 text-slate-700">
            <div class="font-bold">Giỏ hàng trống</div>
            <div class="text-sm mt-2">Bạn cần chọn sản phẩm trước khi thanh toán.</div>
            <button class="mt-4 inline-flex items-center justify-center rounded-xl bg-energy-blue px-4 py-2 text-white font-extrabold hover:bg-energy-blue/90"
                    @onclick="GoToCatalog">
                Quay lại sản phẩm
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-7 space-y-4">
                <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6">
                    <div class="font-extrabold text-slate-900">Thông tin khách hàng</div>
                    <div class="text-sm text-slate-600 mt-1">Thông tin này sẽ được dùng để tạo đơn.</div>

                    <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="md:col-span-2">
                            <label class="text-sm font-semibold text-slate-700">Họ và tên</label>
                            <input class="mt-1 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 outline-none focus:ring-2 focus:ring-energy-blue/30"
                                   @bind="checkout.Name"
                                   placeholder="VD: Nguyễn Văn A" />
                        </div>

                        <div>
                            <label class="text-sm font-semibold text-slate-700">Số điện thoại</label>
                            <input class="mt-1 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 outline-none focus:ring-2 focus:ring-energy-blue/30"
                                   @bind="checkout.Phone"
                                   placeholder="VD: 0901234567" />
                        </div>

                        <div class="md:col-span-1">
                            <label class="text-sm font-semibold text-slate-700">Phí vận chuyển</label>
                            <div class="mt-1 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 font-extrabold text-energy-blue">
                                @MoneyFormat.Vnd(ShippingCost)
                            </div>
                        </div>

                        <div class="md:col-span-2">
                            <label class="text-sm font-semibold text-slate-700">Địa chỉ</label>
                            <input class="mt-1 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 outline-none focus:ring-2 focus:ring-energy-blue/30"
                                   @bind="checkout.Address"
                                   placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" />
                        </div>

                        <div class="md:col-span-2">
                            <label class="text-sm font-semibold text-slate-700">Ghi chú (tùy chọn)</label>
                            <textarea class="mt-1 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 outline-none focus:ring-2 focus:ring-energy-blue/30"
                                      rows="3"
                                      @bind="checkout.Notes"
                                      placeholder="VD: Gọi trước khi giao hàng"></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="mt-4 rounded-xl ring-1 ring-energy-red/30 bg-energy-red/10 p-3 text-sm text-energy-red font-semibold">
                            @errorMessage
                        </div>
                    }

                    <div class="mt-5 flex flex-col sm:flex-row gap-3">
                        <button class="flex-1 inline-flex items-center justify-center rounded-xl bg-energy-red px-4 py-3 text-white font-extrabold hover:bg-energy-red/90"
                                @onclick="PlaceOrder">
                            Đặt hàng
                        </button>
                        <button class="flex-1 inline-flex items-center justify-center rounded-xl ring-1 ring-slate-200 px-4 py-3 text-slate-800 font-bold hover:ring-energy-blue/30"
                                @onclick="GoToCart">
                            Quay lại giỏ
                        </button>
                    </div>

                    <div class="mt-4 text-xs text-slate-500">
                        MVP: chưa tích hợp thanh toán cổng. Nhấn “Đặt hàng” sẽ tạo đơn ngay lập tức và hiển thị trang xác nhận.
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5 space-y-4">
                <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6">
                    <div class="font-extrabold text-slate-900">Tóm tắt đơn</div>
                    <div class="text-sm text-slate-600 mt-1">Tính theo giá sau giảm.</div>

                    <div class="mt-4 space-y-3">
                        @foreach (var item in Cart.Items)
                        {
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="text-sm font-bold text-slate-900 truncate">@item.ProductName</div>
                                    <div class="text-xs text-slate-600 truncate">
                                        @item.VariantDisplayName (@item.Quantity)
                                    </div>
                                </div>
                                <div class="font-extrabold text-energy-blue">
                                    @MoneyFormat.Vnd(item.LineSubtotalAfterDiscount)
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-5 border-t border-slate-200/70 pt-4 space-y-2">
                        <div class="flex items-center justify-between">
                            <div class="text-slate-600">Tạm tính</div>
                            <div class="font-extrabold text-slate-900">@MoneyFormat.Vnd(Cart.SubtotalAfterDiscount)</div>
                        </div>
                        @if (Cart.DiscountTotal > 0)
                        {
                            <div class="flex items-center justify-between">
                                <div class="text-slate-600">Giảm giá</div>
                                <div class="font-extrabold text-energy-red">-@MoneyFormat.Vnd(Cart.DiscountTotal)</div>
                            </div>
                        }
                        <div class="flex items-center justify-between">
                            <div class="text-slate-600">Phí vận chuyển</div>
                            <div class="font-extrabold text-slate-900">@MoneyFormat.Vnd(ShippingCost)</div>
                        </div>

                        <div class="flex items-center justify-between pt-3 border-t border-slate-200/70">
                            <div class="text-slate-900 font-extrabold">Tổng</div>
                            <div class="text-energy-blue font-extrabold text-lg">
                                @MoneyFormat.Vnd(Cart.SubtotalAfterDiscount + ShippingCost)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-blue-50/50 ring-1 ring-energy-blue/20 rounded-2xl p-4 text-sm text-slate-700">
                    Thông tin đơn của bạn sẽ được lưu trong bộ nhớ server cho đến khi bạn đóng phiên (MVP, không dùng database).
                </div>
            </div>
        </div>
    }
</div>

@code {
    private CustomerInfo checkout = new();
    private string? errorMessage;

    // MVP: phí cố định, dễ thay đổi về sau.
    private decimal ShippingCost => 35000m;

    private void PlaceOrder()
    {
        errorMessage = null;

        if (Cart.Items.Count == 0)
        {
            errorMessage = "Giỏ hàng trống.";
            return;
        }

        if (string.IsNullOrWhiteSpace(checkout.Name))
        {
            errorMessage = "Vui lòng nhập họ và tên.";
            return;
        }

        var phoneDigits = new string((checkout.Phone ?? string.Empty).Where(char.IsDigit).ToArray());
        if (phoneDigits.Length < 9)
        {
            errorMessage = "Số điện thoại chưa hợp lệ.";
            return;
        }

        if (string.IsNullOrWhiteSpace(checkout.Address) || checkout.Address.Trim().Length < 10)
        {
            errorMessage = "Vui lòng nhập địa chỉ đầy đủ.";
            return;
        }

        try
        {
            // Normalize phone.
            checkout.Phone = phoneDigits;

            var orderId = OrderService.PlaceOrder(checkout, Cart, ShippingCost);
            Nav.NavigateTo($"/order/confirmation/{orderId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void GoToCatalog() => Nav.NavigateTo("/catalog");

    private void GoToCart() => Nav.NavigateTo("/cart");
}

