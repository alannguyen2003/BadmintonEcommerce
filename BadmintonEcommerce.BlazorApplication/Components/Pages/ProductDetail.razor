@page "/product/{slug}"
@using BadmintonEcommerce.BlazorApplication.Models
@using BadmintonEcommerce.BlazorApplication.Services
@rendermode InteractiveServer

@inject ProductCatalog Catalog
@inject CartStateService Cart
@inject NavigationManager Nav

@if (product is null)
{
    <div class="text-center py-12">
        <h1 class="text-xl font-extrabold text-slate-900">Sản phẩm không tồn tại</h1>
        <div class="text-slate-600 mt-2">
            Có thể bạn đã nhập sai đường dẫn hoặc sản phẩm đã bị xóa.
        </div>
        <button class="mt-6 inline-flex items-center rounded-xl bg-energy-blue px-4 py-2 text-white font-bold hover:bg-energy-blue/90"
                @onclick="GoToCatalog">
            Quay lại danh sách
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-6">
            <div class="rounded-2xl overflow-hidden ring-1 ring-slate-200/70 bg-white/70">
                <div class="aspect-[4/3] bg-slate-50">
                    <img src="@product.HeroImageUrl" alt="@product.Name" class="w-full h-full object-cover" />
                </div>
            </div>
        </div>

        <div class="lg:col-span-6 space-y-5">
            <div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900">@product.Name</h1>
                <div class="text-sm text-slate-500 font-semibold mt-1">@product.Brand</div>
            </div>

            <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6 space-y-4">
                <div class="flex flex-wrap items-center gap-3">
                    @if (product.DiscountPercent is not null && product.DiscountPercent > 0)
                    {
                        <div class="inline-flex items-center rounded-full bg-energy-red/10 text-energy-red px-3 py-1 text-xs font-bold">
                            Giảm @product.DiscountPercent.Value%
                        </div>
                    }
                    <div class="text-xl font-extrabold text-energy-blue">
                        @MoneyFormat.Vnd(prices.UnitPriceAfterDiscount)
                    </div>
                    @if (product.DiscountPercent is not null && product.DiscountPercent > 0)
                    {
                        <div class="text-sm text-slate-400 line-through">
                            @MoneyFormat.Vnd(prices.UnitPriceBeforeDiscount)
                        </div>
                    }
                </div>

                <div class="space-y-2">
                    <div class="font-bold text-slate-900">Chọn biến thể</div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @foreach (var v in product.Variants)
                        {
                            var isSelected = v.Id == selectedVariantId;
                            <button @onclick="() => SelectVariant(v.Id)"
                                    class="rounded-2xl px-4 py-3 text-left ring-1 transition shadow-sm @(isSelected ? "ring-energy-blue/50 bg-blue-50/60" : "ring-slate-200/70 hover:ring-energy-blue/30 bg-white/60")">
                                <div class="font-bold text-slate-900">@v.DisplayName</div>
                                <div class="text-xs text-slate-600 mt-1">
                                    @string.Join(", ", v.Attributes.Select(kv => $"{kv.Key}={kv.Value}"))
                                </div>
                                <div class="text-xs mt-2 text-slate-500">
                                    Tồn: <span class="font-semibold">@v.Stock</span>
                                </div>
                            </button>
                        }
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                    <div class="flex items-center gap-3">
                        <button class="rounded-xl ring-1 ring-slate-200 px-3 py-2 font-bold hover:ring-energy-blue/40"
                                @onclick="DecreaseQty">-</button>
                        <div class="min-w-[3rem] text-center font-extrabold text-slate-900">@quantity</div>
                        <button class="rounded-xl ring-1 ring-slate-200 px-3 py-2 font-bold hover:ring-energy-blue/40"
                                @onclick="IncreaseQty">+</button>
                    </div>

                    <div class="flex-1" />

                    <button class="inline-flex items-center justify-center rounded-xl bg-energy-red px-4 py-3 text-white font-extrabold hover:bg-energy-red/90 disabled:opacity-50"
                            disabled="@(selectedVariant is null || selectedVariant.Stock <= 0)"
                            @onclick="AddToCart">
                        Thêm vào giỏ
                    </button>
                </div>

                <div class="text-sm text-slate-600">
                    <span class="font-semibold">Mô tả:</span> @product.Description
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="rounded-2xl ring-1 ring-energy-blue/30 bg-blue-50/50 p-4 text-sm text-slate-700">
                    @statusMessage
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private Product? product;
    private string selectedVariantId = string.Empty;
    private ProductVariant? selectedVariant;
    private (decimal UnitPriceBeforeDiscount, decimal UnitPriceAfterDiscount) prices;

    private int quantity = 1;
    private string statusMessage = string.Empty;

    protected override void OnParametersSet()
    {
        product = !string.IsNullOrWhiteSpace(Slug) ? Catalog.GetBySlug(Slug) : null;

        if (product is null || product.Variants.Count == 0)
        {
            selectedVariantId = string.Empty;
            selectedVariant = null;
            prices = (0, 0);
            return;
        }

        selectedVariantId = product.Variants[0].Id;
        SelectVariant(selectedVariantId);
    }

    private void SelectVariant(string variantId)
    {
        selectedVariantId = variantId;
        selectedVariant = product?.Variants.FirstOrDefault(v => v.Id == variantId);
        quantity = 1;
        statusMessage = string.Empty;

        if (product is not null && selectedVariant is not null)
        {
            prices = product.GetPrices(selectedVariant);
        }
        else
        {
            prices = (0, 0);
        }
    }

    private void DecreaseQty()
    {
        if (quantity <= 1) return;
        quantity--;
    }

    private void IncreaseQty()
    {
        if (selectedVariant is null) return;
        quantity = Math.Min(quantity + 1, Math.Max(1, selectedVariant.Stock));
    }

    private void AddToCart()
    {
        if (product is null || selectedVariant is null) return;

        Cart.AddItem(product, selectedVariant, quantity);

        statusMessage = $"Đã thêm {quantity} x \"{selectedVariant.DisplayName}\" vào giỏ.";
    }

    private void GoToCatalog() => Nav.NavigateTo("/catalog");
}

