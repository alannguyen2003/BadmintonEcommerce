@page "/cart"
@rendermode InteractiveServer

@using BadmintonEcommerce.BlazorApplication.Models
@using BadmintonEcommerce.BlazorApplication.Services
@implements IDisposable
@inject CartStateService CartService
@inject NavigationManager Nav

<div class="space-y-6">
    <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-energy-blue">Giỏ hàng</h1>
        <p class="text-slate-600 mt-1">Kiểm tra sản phẩm, cập nhật số lượng và tiến hành đặt hàng.</p>
    </div>

    @if (CartService.Items.Count == 0)
    {
        <div class="text-center py-12 bg-white/70 rounded-2xl ring-1 ring-slate-200/70">
            <div class="font-bold text-slate-900">Giỏ hàng hiện đang trống</div>
            <div class="text-sm text-slate-600 mt-2">Bạn hãy chọn một sản phẩm bất kỳ để bắt đầu.</div>
            <button class="mt-6 inline-flex items-center justify-center rounded-xl bg-energy-blue px-5 py-3 text-white font-extrabold hover:bg-energy-blue/90"
                    @onclick="GoToCatalog">
                Tới trang sản phẩm
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-8 space-y-4">
                @foreach (var item in CartService.Items)
                {
                    <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6 flex gap-4">
                        <div class="w-24 h-20 rounded-xl overflow-hidden bg-slate-50 ring-1 ring-slate-200/70 flex-shrink-0">
                            <img src="@item.ImageUrl" alt="@item.VariantDisplayName" class="w-full h-full object-cover" />
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="font-extrabold text-slate-900 truncate">@item.ProductName</div>
                                    <div class="text-sm text-slate-600 truncate">Biến thể: @item.VariantDisplayName</div>
                                    @if (item.VariantAttributes.Count > 0)
                                    {
                                        <div class="text-xs text-slate-500 mt-1">
                                            @string.Join(", ", item.VariantAttributes.Select(kv => $"{kv.Key}={kv.Value}"))
                                        </div>
                                    }
                                </div>

                                <button class="text-slate-500 hover:text-energy-red font-bold text-sm"
                                        @onclick="() => RemoveLine(item.LineId)">
                                    Xóa
                                </button>
                            </div>

                            <div class="mt-3 flex flex-wrap items-center gap-3">
                                <div class="flex items-center gap-2">
                                    <button class="rounded-xl ring-1 ring-slate-200 px-3 py-2 font-bold hover:ring-energy-blue/40"
                                            @onclick="() => ChangeQty(item.LineId, item.Quantity - 1)">-</button>
                                    <div class="min-w-[2.5rem] text-center font-extrabold text-slate-900">@item.Quantity</div>
                                    <button class="rounded-xl ring-1 ring-slate-200 px-3 py-2 font-bold hover:ring-energy-blue/40"
                                            @onclick="() => ChangeQty(item.LineId, item.Quantity + 1)">+</button>
                                </div>

                                <div class="ml-auto text-right">
                                    <div class="text-xs text-slate-500">Đơn giá</div>
                                    <div class="font-extrabold text-energy-blue">@MoneyFormat.Vnd(item.UnitPriceAfterDiscount)</div>
                                    @if (item.UnitPriceAfterDiscount < item.UnitPriceBeforeDiscount)
                                    {
                                        <div class="text-xs text-slate-400 line-through">@MoneyFormat.Vnd(item.UnitPriceBeforeDiscount)</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <aside class="lg:col-span-4 space-y-4">
                <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6">
                    <div class="flex items-center justify-between">
                        <div class="text-slate-600">Tổng tiền (sau giảm)</div>
                        <div class="font-extrabold text-energy-blue">@MoneyFormat.Vnd(CartService.SubtotalAfterDiscount)</div>
                    </div>
                    @if (CartService.DiscountTotal > 0)
                    {
                        <div class="flex items-center justify-between mt-2">
                            <div class="text-slate-600">Giảm giá</div>
                            <div class="font-extrabold text-energy-red">-@MoneyFormat.Vnd(CartService.DiscountTotal)</div>
                        </div>
                    }

                    <div class="mt-4 text-sm text-slate-600">
                        Phí vận chuyển sẽ được tính ở bước checkout.
                    </div>

                    <div class="mt-5 space-y-3">
                        <button class="w-full inline-flex items-center justify-center rounded-xl bg-energy-red px-4 py-3 text-white font-extrabold hover:bg-energy-red/90"
                                @onclick="GoToCheckout">
                            Tiến hành đặt hàng
                        </button>
                        <button class="w-full inline-flex items-center justify-center rounded-xl ring-1 ring-slate-200 px-4 py-3 text-slate-800 font-bold hover:ring-energy-blue/30"
                                @onclick="ClearCart">
                            Xóa giỏ
                        </button>
                    </div>
                </div>

                <div class="bg-blue-50/50 ring-1 ring-energy-blue/20 rounded-2xl p-4 text-sm text-slate-700">
                    Tip: Bạn có thể quay lại trang sản phẩm để thay đổi lựa chọn.
                </div>
            </aside>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += HandleCartChange;
    }

    private void HandleCartChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ChangeQty(string lineId, int qty)
    {
        CartService.SetQuantity(lineId, qty);
    }

    private void RemoveLine(string lineId)
    {
        CartService.RemoveLine(lineId);
    }

    private void ClearCart()
    {
        CartService.Clear();
    }

    public void Dispose()
    {
        CartService.OnChange -= HandleCartChange;
    }

    private void GoToCatalog() => Nav.NavigateTo("/catalog");

    private void GoToCheckout() => Nav.NavigateTo("/checkout");
}

