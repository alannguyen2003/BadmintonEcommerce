@page "/order/confirmation/{orderId}"
@using BadmintonEcommerce.BlazorApplication.Models
@using BadmintonEcommerce.BlazorApplication.Services
@rendermode InteractiveServer

@inject OrderService Orders
@inject NavigationManager Nav

@if (order is null)
{
    <div class="text-center py-12">
        <h1 class="text-xl font-extrabold text-slate-900">Không tìm thấy đơn hàng</h1>
        <div class="text-sm text-slate-600 mt-2">Đơn có thể đã hết hạn do cơ chế lưu trong bộ nhớ (MVP).</div>
        <button class="mt-6 inline-flex items-center justify-center rounded-xl bg-energy-blue px-4 py-2 text-white font-extrabold hover:bg-energy-blue/90"
                @onclick="GoToCatalog">
            Quay lại trang sản phẩm
        </button>
    </div>
}
else
{
    <div class="space-y-6">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-energy-blue">Xác nhận đơn</h1>
            <p class="text-slate-600 mt-1">Cảm ơn bạn đã đặt hàng tại Nguyên Cầu Lông Shop.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-7 space-y-4">
                <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6">
                    <div class="font-extrabold text-slate-900">Thông tin khách hàng</div>

                    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                        <div>
                            <div class="text-slate-500 font-semibold">Mã đơn</div>
                            <div class="font-extrabold text-slate-900">@order.Id</div>
                        </div>
                        <div>
                            <div class="text-slate-500 font-semibold">Thời gian</div>
                            <div class="font-extrabold text-slate-900">@order.CreatedAtUtc.ToLocalTime()</div>
                        </div>
                        <div class="md:col-span-2">
                            <div class="text-slate-500 font-semibold">Tên</div>
                            <div class="font-extrabold text-slate-900">@order.Customer.Name</div>
                        </div>
                        <div>
                            <div class="text-slate-500 font-semibold">Số điện thoại</div>
                            <div class="font-extrabold text-slate-900">@order.Customer.Phone</div>
                        </div>
                        <div class="md:col-span-2">
                            <div class="text-slate-500 font-semibold">Địa chỉ</div>
                            <div class="font-extrabold text-slate-900">@order.Customer.Address</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(order.Customer.Notes))
                        {
                            <div class="md:col-span-2">
                                <div class="text-slate-500 font-semibold">Ghi chú</div>
                                <div class="font-extrabold text-slate-900">@order.Customer.Notes</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6">
                    <div class="font-extrabold text-slate-900">Danh sách sản phẩm</div>
                    <div class="mt-4 space-y-3">
                        @foreach (var it in order.Items)
                        {
                            <div class="flex items-start justify-between gap-4">
                                <div class="min-w-0">
                                    <div class="text-sm font-extrabold text-slate-900 truncate">@it.ProductName</div>
                                    <div class="text-xs text-slate-600 truncate">
                                        @it.VariantDisplayName x @it.Quantity
                                    </div>
                                    @if (it.VariantAttributes.Count > 0)
                                    {
                                        <div class="text-[11px] text-slate-500 mt-1">
                                            @string.Join(", ", it.VariantAttributes.Select(kv => $"{kv.Key}={kv.Value}"))
                                        </div>
                                    }
                                </div>
                                <div class="text-right">
                                    <div class="text-xs text-slate-500">Thành tiền</div>
                                    <div class="font-extrabold text-energy-blue">
                                        @MoneyFormat.Vnd(it.LineSubtotalAfterDiscount)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <aside class="lg:col-span-5 space-y-4">
                <div class="bg-white/70 backdrop-blur rounded-2xl ring-1 ring-slate-200/70 p-4 md:p-6">
                    <div class="font-extrabold text-slate-900">Tổng kết</div>

                    <div class="mt-4 space-y-2 text-sm">
                        <div class="flex items-center justify-between">
                            <div class="text-slate-600">Tạm tính</div>
                            <div class="font-extrabold text-slate-900">@MoneyFormat.Vnd(order.TotalAfterDiscountBeforeShipping)</div>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="text-slate-600">Giảm giá</div>
                            <div class="font-extrabold text-energy-red">-@MoneyFormat.Vnd(order.DiscountTotal)</div>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="text-slate-600">Phí vận chuyển</div>
                            <div class="font-extrabold text-slate-900">@MoneyFormat.Vnd(order.ShippingCost)</div>
                        </div>
                        <div class="pt-3 border-t border-slate-200/70 flex items-center justify-between">
                            <div class="font-extrabold text-slate-900">Tổng cộng</div>
                            <div class="text-energy-blue font-extrabold text-lg">@MoneyFormat.Vnd(order.GrandTotal)</div>
                        </div>
                    </div>

                    <div class="mt-5 space-y-3">
                        <button class="w-full inline-flex items-center justify-center rounded-xl bg-energy-blue px-4 py-3 text-white font-extrabold hover:bg-energy-blue/90"
                                @onclick="GoToCatalog">
                            Tiếp tục mua hàng
                        </button>
                        <button class="w-full inline-flex items-center justify-center rounded-xl ring-1 ring-slate-200 px-4 py-3 text-slate-800 font-bold hover:ring-energy-blue/30"
                                @onclick="GoToCart">
                            Xem lại giỏ
                        </button>
                    </div>
                </div>

                <div class="bg-blue-50/50 ring-1 ring-energy-blue/20 rounded-2xl p-4 text-sm text-slate-700">
                    Lưu ý: Với MVP không dùng database, đơn có thể biến mất khi bạn refresh/đóng phiên server.
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string? OrderId { get; set; }
    private Order? order;

    protected override void OnParametersSet()
    {
        order = !string.IsNullOrWhiteSpace(OrderId) ? Orders.GetById(OrderId) : null;
    }

    private void GoToCatalog() => Nav.NavigateTo("/catalog");
    private void GoToCart() => Nav.NavigateTo("/cart");
}

